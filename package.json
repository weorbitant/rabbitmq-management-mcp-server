{
  "name": "@orbitant/rabbitmq-mcp-server",
  "version": "0.1.1",
  "description": "MCP server for RabbitMQ Management API diagnostics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weorbitant/rabbitmq-management-mcp-server.git"
  },
  "homepage": "https://github.com/weorbitant/rabbitmq-management-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/weorbitant/rabbitmq-management-mcp-server/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rabbitmq-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "rabbitmq",
    "diagnostics"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
