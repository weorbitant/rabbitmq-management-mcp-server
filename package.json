{
  "name": "rabbitmq-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for RabbitMQ Management API diagnostics",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
